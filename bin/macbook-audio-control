#!/usr/bin/env bash
# MacBook Audio Control Center Launcher
# Automatically resolves Python backend from user installation path

INSTALL_DIR="${MACBOOK_AUDIO_DIR:-${HOME}/.local/share/macbook-audio-control}"

if [ ! -f "${INSTALL_DIR}/audio_backend.py" ]; then
    echo "Error: Cannot find audio_backend.py in ${INSTALL_DIR}" >&2
    echo "Please run ./install.sh to set up MacBook Audio Control Center." >&2
    exit 1
fi

exec python3 "${INSTALL_DIR}/audio_backend.py" "$@"
